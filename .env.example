# Copia este archivo como .env y cambia los valores.
# El archivo .env NUNCA se sube al repositorio (agrégalo a .gitignore).
# Usa solo letras y números en las contraseñas: los símbolos pueden romper las URLs de conexión.

POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga

REDIS_PASSWORD=cambia-esto-por-otra-clave-larga

PGADMIN_EMAIL=tu-correo@ejemplo.com
PGADMIN_PASSWORD=cambia-esto-tambien
