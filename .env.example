# Copia este archivo como .env y cambia los valores.
# El archivo .env ya está en .gitignore: nunca se sube al repositorio.
# Usa solo letras y números en las contraseñas: los símbolos pueden romper las URLs de conexión.

POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=cambiaestoporunaclavelarga

REDIS_PASSWORD=cambiaestoporotraclavelarga

# La API se conecta con este rol, que NO es superusuario (RLS depende de eso).
APP_PASSWORD=cambiaestoporunaterceraclavelarga

# Rol que solo usan las migraciones (DDL). La API nunca recibe esta clave.
MIGRATION_PASSWORD=cambiaestoporotraclavelarga

PGADMIN_EMAIL=tu-correo@ejemplo.com
PGADMIN_PASSWORD=cambiaestotambien
